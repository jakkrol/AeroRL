<mujoco model="Drone">
    <default>
        <!-- Parametry fizyczne z shared.xml -->
        <default class="body">
            <geom condim="1" friction=".7" solimp=".9 .99 .003" solref=".015 1" />
            <joint damping=".02" stiffness=".1" armature=".01" solimplimit="0 .99 .01" />
        </default>

        <!-- Ustawienia siły ciągu -->
        <default class="drone">
            <motor gear="0 0 1 0 0 0" />
        </default>
    </default>

    <worldbody>
        <body name="drone" pos="0 0 0.05" childclass="body">
            <freejoint name="root" />
            
            <!-- Główna bryła drona -->
            <geom name="core" type="box" mass="1" pos="0 0 0" size="0.1 0.1 0.05" rgba="0.0 0.0 1.0 1.0" />
            <site name="sensor" />
            <camera name="track_cam" pos="-2 0 1" xyaxes="0 -1 0 1 0 2" mode="trackcom" />
            
            <!-- Ramię 0 (Prawy przód) -->
            <body name="arm0" pos="0 0 0">
                <geom type="capsule" mass="0" fromto="0 0 0  0.2 0.2 0" size="0.02" rgba="0.0 0.0 1.0 1.0"/>
                <site name="thrust0" pos="0.2 0.2 0"/>
                <geom type="cylinder" mass="0" pos="0.2 0.2 0.02" size="0.1 0.01" rgba="1.0 0.0 0.0 1.0"/>
            </body>

            <!-- Ramię 1 (Lewy przód) -->
            <body name="arm1" pos="0 0 0">
                <geom type="capsule" mass="0" fromto="0 0 0 -0.2 0.2 0" size="0.02" rgba="0.0 0.0 1.0 1.0"/>
                <site name="thrust1" pos="-0.2 0.2 0"/>
                <geom type="cylinder" mass="0" pos="-0.2 0.2 0.02" size="0.1 0.01" rgba="1.0 0.0 0.0 1.0"/>
            </body>

            <!-- Ramię 2 (Lewy tył) -->
            <body name="arm2" pos="0 0 0">
                <geom type="capsule" mass="0" fromto="0 0 0 -0.2 -0.2 0" size="0.02" rgba="0.0 0.0 1.0 1.0"/>
                <site name="thrust2" pos="-0.2 -0.2 0"/>
                <geom type="cylinder" mass="0" pos="-0.2 -0.2 0.02" size="0.1 0.01" rgba="1.0 0.0 0.0 1.0"/>
            </body>

            <!-- Ramię 3 (Prawy tył) -->
            <body name="arm3" pos="0 0 0">
                <geom type="capsule" mass="0" fromto="0 0 0  0.2 -0.2 0" size="0.02" rgba="0.0 0.0 1.0 1.0"/>
                <site name="thrust3" pos="0.2 -0.2 0"/>
                <geom type="cylinder" mass="0" pos="0.2 -0.2 0.02" size="0.1 0.01" rgba="1.0 0.0 0.0 1.0"/>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor class="drone" name="thrust0" site="thrust0" />
        <motor class="drone" name="thrust1" site="thrust1" />
        <motor class="drone" name="thrust2" site="thrust2" />
        <motor class="drone" name="thrust3" site="thrust3" />
    </actuator>

    <sensor>
        <velocimeter name="body_vel" site="sensor" />
    </sensor>
</mujoco>